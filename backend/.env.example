# Never commit a real .env file or Atlas URI to source control.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/toabea_closet?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-run
# Set to true for ONE deploy to overwrite the existing admin's password with the value above, then remove it.
# BOOTSTRAP_ADMIN_RESET=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500
PORT=8080

# Paystack: get these from your Paystack dashboard under Settings > API Keys & Webhooks.
# Use pk_test_/sk_test_ keys while developing, then switch to pk_live_/sk_live_ for real charges.
PAYSTACK_SECRET_KEY=sk_test_replace_with_real_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_real_public_key
# Ghana's standard published rate for local cards and mobile money is 1.95% with no flat fee.
# Confirm the exact rate on your own Paystack pricing page and adjust if it differs.
PAYSTACK_FEE_PERCENT=1.95
PAYSTACK_FEE_FLAT=0

# Cloudinary: get these from your Cloudinary dashboard home page.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_UPLOAD_FOLDER=toabea-products
